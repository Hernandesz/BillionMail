# SICAEV BillionMail custom core build (amd64), preserving the official runtime stack.
# Staging-safe: only replaces the compiled Go binary and frontend assets.
FROM node:22-bookworm-slim AS webbuild
WORKDIR /source/core/frontend
RUN corepack enable && corepack prepare pnpm@10.17.0 --activate
COPY core/frontend/package.json core/frontend/pnpm-lock.yaml ./
RUN pnpm install --no-frozen-lockfile
COPY core/frontend/ ./
RUN pnpm run build

FROM golang:1.23-bookworm AS gobuild
WORKDIR /source/core
COPY core/go.mod core/go.sum ./
RUN go mod download
COPY core/ ./
RUN go mod tidy && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o /out/billionmail main.go

FROM billionmail/core:4.9.1
COPY --from=gobuild /out/billionmail /opt/billionmail/core/billionmail
COPY --from=webbuild /source/core/frontend/dist/ /opt/billionmail/core/public/dist/
